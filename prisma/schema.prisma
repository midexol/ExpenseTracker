generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  email          String   @unique
  passwordHash   String
  name           String
  xp             Int      @default(0)
  coins          Int      @default(0)
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActiveDate String? // "YYYY-MM-DD" in the user's local day
  timezoneOffset Int      @default(0) // minutes, JS getTimezoneOffset() convention
  createdAt      DateTime @default(now())

  // Reminder de-duplication: last local date ("YYYY-MM-DD") a reminder of each kind was sent
  lastTodoReminderDate    String?
  lastExpenseReminderDate String?
  lastChallengeReminderDate String?

  expenses          Expense[]
  budget            Budget?
  todos             Todo[]
  achievements      UserAchievement[]
  pushSubscriptions PushSubscription[]
  habits            Habit[]
  habitLogs         HabitLog[]
  dailyMetrics      DailyMetric[]
  challenge75       Challenge75?
  challenge75Logs   Challenge75Log[]
}

model Expense {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  category  String
  amount    Float
  currency  String   @default("NGN")
  date      String // "YYYY-MM-DD"
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model Budget {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  userId   String @unique @db.ObjectId
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount   Float
  period   String @default("Monthly") // "Weekly" | "Monthly"
  currency String @default("NGN")
}

model Todo {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @db.ObjectId
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  notes       String?
  dueDate     String? // "YYYY-MM-DD"
  priority    String    @default("Med") // "Low" | "Med" | "High"
  recurrence  String    @default("NONE") // "NONE" | "DAILY" | "WEEKLY"
  completed   Boolean   @default(false)
  completedAt DateTime?
  xpValue     Int       @default(10)
  createdAt   DateTime  @default(now())

  @@index([userId, completed])
}

model Achievement {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  key         String @unique
  name        String
  description String
  icon        String
  xpReward    Int    @default(0)
  coinReward  Int    @default(0)
  sortOrder   Int    @default(0)

  unlocks UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  userId        String      @db.ObjectId
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String      @db.ObjectId
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
}

model PushSubscription {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Habit {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  category  String   @default("General") // "Health", "Mind", "Fitness", "Work", "General"
  color     String   @default("coral") // "coral", "violet", "cyber", "emerald", "amber", "cyan"
  icon      String   @default("check") // icon identifier
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  logs HabitLog[]

  @@index([userId])
}

model HabitLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  habitId   String   @db.ObjectId
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // "YYYY-MM-DD"
  completed Boolean  @default(true)

  @@unique([habitId, date])
  @@index([userId, date])
}

model DailyMetric {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // "YYYY-MM-DD"
  sleepHrs  Float?
  mood      Int?     // 1 - 10
  stress    Int?     // 1 - 10
  energy    Int?     // 1 - 10

  @@unique([userId, date])
  @@index([userId])
}

model Challenge75 {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @unique @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       String   @default("NOT_STARTED") // "NOT_STARTED" | "ACTIVE" | "COMPLETED" | "FAILED"
  startDate    String?  // "YYYY-MM-DD"
  currentDay   Int      @default(1) // 1..75
  attemptCount Int      @default(1)
  failedDate   String?  // "YYYY-MM-DD" if failed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  logs Challenge75Log[]
}

model Challenge75Log {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  challengeId   String      @db.ObjectId
  challenge     Challenge75 @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId        String      @db.ObjectId
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          String      // "YYYY-MM-DD"
  dayNumber     Int         // Day 1..75
  attemptNumber Int         @default(1)
  diet          Boolean     @default(false)
  water         Boolean     @default(false)
  workouts      Boolean     @default(false)
  reading       Boolean     @default(false)
  photo         Boolean     @default(false)
  allCompleted  Boolean     @default(false)

  @@unique([challengeId, date])
  @@index([userId, date])
}
